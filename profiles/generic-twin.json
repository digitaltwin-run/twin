    "runStatuses": ["DRAFT", "COMPILED", "RUNNING", "BLOCKED", "AWAITING_APPROVAL", "COMPLETED", "FAILED", "CANCELLED"],
    "candidateStatuses": ["PROPOSED", "SHORTLISTED", "SELECTED", "REJECTED", "REALIZED", "VERIFIED"],
    "changeQueueStates": ["QUEUED", "APPLYING", "REGENERATING", "VERIFYING", "APPLIED", "REVERTED", "FAILED"],
    "autoApplySafe": {
      "explicitAllowlistRequired": true,
      "reversibleOnly": true,
      "compatibilityValidationRequired": true,
      "lifecycleGateRequired": true,
      "authorityRequired": true
    }
  },
